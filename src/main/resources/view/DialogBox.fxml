<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<!--
  One speech bubble. fx:root means the loader fills in the HBox that
  DialogBox itself is, rather than creating a new one, which is what lets
  DialogBox be its own layout and controller at the same time.
-->
<fx:root alignment="TOP_RIGHT" maxHeight="-Infinity" prefWidth="400.0" spacing="10.0"
         type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
    </padding>
    <children>
        <!-- wrapText keeps a long reply inside the window instead of stretching it. -->
        <Label fx:id="dialog" styleClass="dialog-label" text="Label" wrapText="true" HBox.hgrow="ALWAYS" />
        <!-- Size is set by DialogBox, which must match it to the circular clip. -->
        <ImageView fx:id="displayPicture" pickOnBounds="true" preserveRatio="true" />
    </children>
</fx:root>
